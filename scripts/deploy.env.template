# ---------- Build / Image ----------
OCI_REGION=us-ashburn-1
OCI_TENANCY_NAMESPACE=changeme
OCI_TENANCY_NAME=changeme
APP_NAME=ocr-viewer
IMAGE_TAG=latest

# ---------- OCI Auth in runtime ----------
OCI_AUTH_MODE=resource_principal
NAMESPACE=changeme
BUCKET_NAME=changeme
COMPARTMENT_OCID=ocid1.compartment.oc1..changeme
OCR_OUTPUT_PREFIX=ocr
MAX_UPLOAD_MB=10

# ---------- Networking ----------
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..changeme
SUBNET_OCID_CONTAINER=ocid1.subnet.oc1..changeme
SUBNET_OCID_LB=ocid1.subnet.oc1..changeme

# ---------- Container Instance ----------
CONTAINER_INSTANCE_SHAPE=CI.Standard.E4.Flex
CONTAINER_CPU=1
CONTAINER_MEMORY_IN_GBS=2

# ---------- Load Balancer ----------
LB_SHAPE=flexible
LB_MIN_BW=10
LB_MAX_BW=10
LISTENER_PORT=443
BACKEND_PORT=8501
HEALTHCHECK_PORT=8501

# ---------- TLS ----------
# You can provide either CERTIFICATE_NAME (already uploaded in OCI LB)
# or leave it empty and create an HTTP listener first.
CERTIFICATE_NAME=

# ---------- Optional WAF ----------
ENABLE_WAF=false
